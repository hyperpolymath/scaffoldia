#
# STATE.a2ml — Project state checkpoint
#
# This is the STATE file for scaffoldia itself.

[metadata]
project = "scaffoldia"
version = "0.1.0"
last-updated = "2026-11-15"
status = "active"  # active | paused | archived

[project-context]
name = "scaffoldia"
purpose = "Full-featured repository designer for the RSR estate: composes spine@pin x archetype/pack x features x capability profile into new repos and retrofits existing ones. Must consume the spine current deed-based archetype, variant, provenance and mint-answer contracts (rsr-template-repo ADR-0002/0003, partly superseded 2026-10-06); cannot invent a second format."
completion-percentage = 5

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[route-to-mvp]
milestones = [
  { name = "Phase 0: RSR shell extracted from reposystem (2026-06-26), identity + hygiene", completion = 90 },
  { name = "Phase 1: proposed composer design ADR; decision and review outstanding", completion = 0 },
  { name = "Phase 2: parse spine praxis deeds, repo deed clauses, overlays and capability profile; julia-library first", completion = 0 },
  { name = "Phase 3: retrofit engine (pack-diff against existing repos)", completion = 0 },
  { name = "Phase 4: template-maintenance sync loop (regenerate rsr-*-template-repo family until cut-off)", completion = 0 },
]

[blockers-and-issues]
issues = [
  "Composer ADR-0002 proposed, not accepted: must compare dormant Haskell/Nickel, Rust core, and ABI/FFI options against working evidence; canonical repo is here, historical registry harvested as untrusted source data",
  "Current source tree has no core composer, mint planner, retrofit engine or working cross-language ABI; CI and local validators contain stale template assumptions",
  "Current canonical contract is deed-based; old VARIANT.a2ml / ARCHETYPE.a2ml references are superseded in part by rsr-template-repo ADR-0002/0003 (2026-10-06)",
  "repo-batcher absorption (reposystem#56 V->Zig port) undecided — revisit after composer v0.1",
]

[critical-next-actions]
actions = [
  "Review ADR-0002 against current standards and spine; select engine via working spike without creating a competing contract schema",
  "Implement pinned-source and deed/archetype readers, deterministic plan and dry-run, then mint and retrofit using one planner",
  "Reconcile validation/CI failures; prove any retained Idris2-Zig ABI using real linked symbol and behaviour tests, or retire unused seam",
]

[fork-resolution]
# Two scaffoldia codebases existed with no recorded relationship. Resolved
# 2026-07-21 (see machine-readable-design/harvested-registry/README.adoc):
decision = "this repo = canonical design surface + consumer of spine contracts; developer-ecosystem/scaffoldia (GitLab lineage, implemented Haskell CLI + Nickel builder) = dormant engine, registry harvested as data, no parallel development"
profile-axis = "capability set from metadatastician/standards .machine_readable/template-capability-gates.toml; written as (rsr-profile) in the repository deed by current spine repo-init"

[maintenance-status]
last-run-utc = "never"
last-report = "docs/reports/maintenance/latest.json"
last-result = "unknown"  # unknown | pass | warn | fail
open-warnings = 0
open-failures = 0

[ecosystem]
part-of = ["RSR Framework", "scaffolding stack (standards -> rsr-template-repo -> scaffoldia)"]
depends-on = ["hyperpolymath/rsr-template-repo", "metadatastician/standards"]
